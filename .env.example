# ============================================================
# 复制此文件为 .env，填入真实密钥
# .env 文件不要提交到 git（已在 .gitignore 中排除）
# ============================================================

# ---------- 对话 LLM ----------
# 智谱 API（推荐学生党，注册送免费额度）：https://open.bigmodel.cn/
# glm-4-flash 是免费模型，白嫖即可
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# OpenAI API（可选，需与 CHAT_PROVIDER=openai 搭配使用）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# 对话用哪个提供商：zhipu | openai
CHAT_PROVIDER=zhipu
# 对话模型名
LLM_MODEL=glm-4-flash

# ---------- Embedding（向量化）----------
# 注意：智谱的免费额度只覆盖对话模型，Embedding 是按量计费的，
# 所以这里默认用本地开源模型，做到零成本。
#
#   local  = 本地 BAAI/bge-small-zh-v1.5（免费、离线、首次下载约 90MB）
#   zhipu  = 智谱 embedding-3 / embedding-2（按量计费）
#   openai = OpenAI text-embedding-3-small（按量计费）
EMBEDDING_PROVIDER=local
# 留空表示用该提供商的默认模型：
#   local → BAAI/bge-small-zh-v1.5 / zhipu → embedding-3 / openai → text-embedding-3-small
EMBEDDING_MODEL=

# ---------- 应用配置 ----------
APP_NAME=中北大学智能问答助手
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 允许跨域的来源，逗号分隔。留空则使用 localhost 开发默认值。
# 切勿填写 "*"：本服务开启了 allow_credentials，通配符属于非法组合，会被浏览器拒绝。
# 生产环境示例：CORS_ORIGINS=https://qa.example.com,https://www.example.com
CORS_ORIGINS=

# ---------- RAG 配置 ----------
# Chunk 大小（字符数，越小越聚焦）
CHUNK_SIZE=300
CHUNK_OVERLAP=50
# 检索时取前 K 个最相关的文档块
RETRIEVAL_TOP_K=5
# 相关性阈值：低于该分数的片段会被丢弃，避免无关内容干扰 LLM。
# 设 0 表示不过滤。注意相似度分数只有相对意义，实测相关片段在 0.3~0.7、
# 无关内容在 0.05~0.2，所以 0.15 是个保守值。
RETRIEVAL_SCORE_THRESHOLD=0.15
