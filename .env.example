# ============================================================
# 复制此文件为 .env，填入真实密钥
# .env 文件不要提交到 git（已在 .gitignore 中排除）
# ============================================================

# ---------- LLM API ----------
# 选一个即可，推荐用智谱（便宜稳定），OpenAI 质量最好
# 智谱 API（推荐学生党，注册送免费额度）：https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# OpenAI API（可选）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# 通义千问 API（可选，阿里云）：https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ---------- 应用配置 ----------
APP_NAME=中北大学智能问答助手
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ---------- RAG 配置 ----------
# Embedding 模型（智谱 embedding-2 / OpenAI text-embedding-3-small）
EMBEDDING_MODEL=embedding-2
# Chunk 大小（字符数）
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# 检索时取前 K 个最相关的文档块
TOP_K=4
